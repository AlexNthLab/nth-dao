{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nth-dao:schema:trade-rule-manifest:1",
  "title": "Nth Trade Rule Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "protocol_version",
    "rule_id",
    "version",
    "publisher_did",
    "summary",
    "applies_to",
    "families",
    "resources",
    "dependencies",
    "conflicts",
    "required_capabilities",
    "hook_contracts",
    "execution",
    "published_at",
    "not_after",
    "extensions",
    "proof"
  ],
  "properties": {
    "kind": {
      "const": "org.nthdao.trade.rule-manifest"
    },
    "protocol_version": {
      "const": "1.0"
    },
    "rule_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+(?:/[a-z0-9](?:[a-z0-9._-]{0,30}[a-z0-9])?)?$"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "publisher_did": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256,
      "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/namespacedToken"
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/namespacedToken"
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/ruleReference"
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/ruleReference"
      }
    },
    "required_capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/namespacedToken"
      }
    },
    "hook_contracts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/hookContract"
      }
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "published_at": {
      "$ref": "#/$defs/timestamp"
    },
    "not_after": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+/[a-z0-9](?:[a-z0-9._-]{0,30}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "proof": {
      "$ref": "#/$defs/proof"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 35,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "namespacedToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "media_type",
        "digest",
        "size"
      ],
      "properties": {
        "purpose": {
          "$ref": "#/$defs/namespacedToken"
        },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      }
    },
    "ruleReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "digest"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+(?:/[a-z0-9](?:[a-z0-9._-]{0,30}[a-z0-9])?)?$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "hookContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "input_schema_digest",
        "output_schema_digest",
        "side_effect",
        "permissions"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/namespacedToken"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
        },
        "input_schema_digest": {
          "$ref": "#/$defs/digest"
        },
        "output_schema_digest": {
          "$ref": "#/$defs/digest"
        },
        "side_effect": {
          "enum": [
            "none",
            "local",
            "external",
            "funds"
          ]
        },
        "permissions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/namespacedToken"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "permissions"
      ],
      "properties": {
        "mode": {
          "enum": [
            "declarative",
            "adapter",
            "sandboxed_wasm",
            "external_service"
          ]
        },
        "permissions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/namespacedToken"
          }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "created",
        "verification_method",
        "proof_purpose",
        "proof_value"
      ],
      "properties": {
        "type": {
          "const": "NthEd25519SignatureV1"
        },
        "created": {
          "$ref": "#/$defs/timestamp"
        },
        "verification_method": {
          "type": "string",
          "minLength": 18,
          "maxLength": 300,
          "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+#[^\\s]+$"
        },
        "proof_purpose": {
          "const": "assertionMethod"
        },
        "proof_value": {
          "type": "string",
          "minLength": 86,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  }
}
