{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nthdao.org/schemas/trade-rule-recognition-v1.json",
  "title": "NTH DAO Trade Rule Recognition v1",
  "$comment": "Structural schema only. Implementations must also verify canonical ordering, real UTC dates, temporal ordering, DID/signature semantics, recognition_id derivation, package binding, and predecessor-chain rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "protocol_version",
    "recognition_id",
    "rule_id",
    "package_digest",
    "issuer_did",
    "sequence",
    "previous_statement_digest",
    "decision",
    "reason_codes",
    "issued_at",
    "not_after",
    "proof"
  ],
  "properties": {
    "kind": {"const": "nth.dao.trade.rule-recognition"},
    "protocol_version": {"const": "1"},
    "recognition_id": {
      "type": "string",
      "pattern": "^nth-trade-recognition-sha256:[0-9a-f]{64}$"
    },
    "rule_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+(?:\\/[a-z0-9](?:[a-z0-9._-]{0,30}[a-z0-9])?)?$"
    },
    "package_digest": {"$ref": "#/$defs/digest"},
    "issuer_did": {
      "type": "string",
      "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "previous_statement_digest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/digest"}
      ]
    },
    "decision": {
      "enum": ["recognized", "deprecated", "revoked"]
    },
    "reason_codes": {
      "type": "array",
      "$comment": "The protocol validator additionally requires ascending lexical order.",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
      }
    },
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "not_after": {"$ref": "#/$defs/timestamp"},
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "created",
        "verification_method",
        "proof_purpose",
        "proof_value"
      ],
      "properties": {
        "type": {"const": "NthEd25519SignatureV1"},
        "created": {"$ref": "#/$defs/timestamp"},
        "verification_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "proof_purpose": {"const": "tradeRuleRecognition"},
        "proof_value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"sequence": {"const": 1}},
        "required": ["sequence"]
      },
      "then": {
        "properties": {"previous_statement_digest": {"type": "null"}}
      },
      "else": {
        "properties": {
          "previous_statement_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    {
      "if": {
        "properties": {"decision": {"enum": ["deprecated", "revoked"]}},
        "required": ["decision"]
      },
      "then": {
        "properties": {"reason_codes": {"minItems": 1}}
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.(?!000000)[0-9]{6})?Z$"
    }
  }
}
