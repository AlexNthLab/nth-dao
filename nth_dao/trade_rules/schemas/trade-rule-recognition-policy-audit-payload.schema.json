{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nthdao.org/schemas/trade-rule-recognition-policy-audit-payload-v1.json",
  "title": "NTH DAO Trade Rule Recognition Policy Updated Spine Payload v1",
  "$comment": "Structural schema only. Implementations must also validate real canonical UTC timestamps and match every field to the exact signed policy revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "policy_id",
    "policy_digest",
    "node_did",
    "signer_did",
    "sequence",
    "previous_policy_digest",
    "issued_at"
  ],
  "properties": {
    "protocol_version": {"const": "1"},
    "policy_id": {
      "type": "string",
      "pattern": "^nth-trade-recognition-policy-sha256:[0-9a-f]{64}$"
    },
    "policy_digest": {"$ref": "#/$defs/digest"},
    "node_did": {"$ref": "#/$defs/did"},
    "signer_did": {"$ref": "#/$defs/did"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "previous_policy_digest": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
    },
    "issued_at": {"$ref": "#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {"properties": {"sequence": {"const": 1}}, "required": ["sequence"]},
      "then": {"properties": {"previous_policy_digest": {"type": "null"}}},
      "else": {"properties": {"previous_policy_digest": {"$ref": "#/$defs/digest"}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "did": {"type": "string", "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]{44}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.(?!000000)[0-9]{6})?Z$"
    }
  }
}
