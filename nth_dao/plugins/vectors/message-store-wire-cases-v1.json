  "semantics": {
    "consume": "generation-and-hash-cas-atomic-at-most-once-logical-delete",
    "delete": "generation-and-hash-cas-logical-only-not-secure-erasure",
    "get": "read-many-records-only",
    "list": "metadata-only-in-increasing-sequence-order",
    "put": "live-record-immutable-idempotent-by-complete-record",
    "ttl": "absolute-unix-epoch-milliseconds"
  },
  "state_transition_vectors": [
    {
      "name": "delayed-delete-cannot-remove-replacement",
      "principal": "group:alpha",
      "steps": [
        {
          "expected_fields": {
            "found": true,
            "replayed": false,
            "sequence": 1
          },
          "input": {
            "delivery_mode": "read-many",
            "expires_at_ms": 0,
            "message_id": "message-aba",
            "message_json": "{\"body\":\"A\",\"kind\":\"chat\"}",
            "message_sha256": "53aa1c590f5a8c5a9873019a685da0f5ea56aec0d0dd4a4e1023883dac9a0711",
            "namespace": "group:alpha/channel:general",
            "operation": "put",
            "retention_mode": "session"
          }
        },
        {
          "expected_fields": {
            "deleted": true,
            "found": true
          },
          "input": {
            "expected_message_sha256": "53aa1c590f5a8c5a9873019a685da0f5ea56aec0d0dd4a4e1023883dac9a0711",
            "expected_sequence": 1,
            "message_id": "message-aba",
            "namespace": "group:alpha/channel:general",
            "operation": "delete"
          }
        },
        {
          "expected_fields": {
            "found": true,
            "replayed": false,
            "sequence": 2
          },
          "input": {
            "delivery_mode": "read-many",
            "expires_at_ms": 0,
            "message_id": "message-aba",
            "message_json": "{\"body\":\"B\",\"kind\":\"chat\"}",
            "message_sha256": "c634e56717d0d48aa60b43b0a26fafd94fbec2edcad0604ceb4f147dd439cc86",
            "namespace": "group:alpha/channel:general",
            "operation": "put",
            "retention_mode": "session"
          }
        },
        {
          "expected_error": "stale-generation",
          "input": {
            "expected_message_sha256": "53aa1c590f5a8c5a9873019a685da0f5ea56aec0d0dd4a4e1023883dac9a0711",
            "expected_sequence": 1,
            "message_id": "message-aba",
            "namespace": "group:alpha/channel:general",
            "operation": "delete"
          }
        },
        {
          "expected_fields": {
            "found": true,
            "message_json": "{\"body\":\"B\",\"kind\":\"chat\"}",
            "message_sha256": "c634e56717d0d48aa60b43b0a26fafd94fbec2edcad0604ceb4f147dd439cc86",
            "sequence": 2
          },
          "input": {
            "message_id": "message-aba",
            "namespace": "group:alpha/channel:general",
            "operation": "get"
          }
        }
      ]
    },
    {
      "name": "consume-replay-is-rejected",
      "principal": "group:alpha",
      "steps": [
        {
          "expected_fields": {
            "found": true,
            "replayed": false,
            "sequence": 1
          },
          "input": {
            "delivery_mode": "consume-on-read",
            "expires_at_ms": 0,
            "message_id": "message-consume",
            "message_json": "{\"body\":\"one-shot\",\"kind\":\"chat\"}",
            "message_sha256": "b277b2c492dcb5f8c6ed1f463fca70e3c6865ed28dfe5a1f82a2dae244b49d51",
            "namespace": "group:alpha/channel:general",
            "operation": "put",
            "retention_mode": "session"
          }
        },
        {
          "expected_fields": {
            "deleted": true,
            "found": true,
            "message_json": "{\"body\":\"one-shot\",\"kind\":\"chat\"}",
            "message_sha256": "b277b2c492dcb5f8c6ed1f463fca70e3c6865ed28dfe5a1f82a2dae244b49d51",
            "sequence": 1
          },
          "input": {
            "expected_message_sha256": "b277b2c492dcb5f8c6ed1f463fca70e3c6865ed28dfe5a1f82a2dae244b49d51",
            "expected_sequence": 1,
            "message_id": "message-consume",
            "namespace": "group:alpha/channel:general",
            "operation": "consume"
          }
        },
        {
          "expected_error": "already-applied",
          "input": {
            "expected_message_sha256": "b277b2c492dcb5f8c6ed1f463fca70e3c6865ed28dfe5a1f82a2dae244b49d51",
            "expected_sequence": 1,
            "message_id": "message-consume",
            "namespace": "group:alpha/channel:general",
            "operation": "consume"
          }
        }
      ]
    },
    {
      "name": "delivery-mode-is-enforced",
      "principal": "group:alpha",
      "steps": [
        {
          "expected_fields": {
            "found": true,
            "replayed": false,
            "sequence": 1
          },
          "input": {
            "delivery_mode": "read-many",
            "expires_at_ms": 0,
            "message_id": "message-mode",
            "message_json": "{\"body\":\"repeatable\",\"kind\":\"chat\"}",
            "message_sha256": "9ea3472e775c2c8e31cb954ceef190a4d7b54ca459ef68786bbfa2a483aea71f",
            "namespace": "group:alpha/channel:general",
            "operation": "put",
            "retention_mode": "session"
          }
        },
        {
          "expected_error": "unsupported-delivery-mode",
          "input": {
            "expected_message_sha256": "9ea3472e775c2c8e31cb954ceef190a4d7b54ca459ef68786bbfa2a483aea71f",
            "expected_sequence": 1,
            "message_id": "message-mode",
            "namespace": "group:alpha/channel:general",
            "operation": "consume"
          }
        }
      ]
    },
    {
      "name": "expired-ttl-is-rejected",
      "principal": "group:alpha",
      "steps": [
        {
          "expected_error": "expired",
          "input": {
            "delivery_mode": "read-many",
            "expires_at_ms": 1750000000000,
            "message_id": "message-expired",
            "message_json": "{\"body\":\"late\",\"kind\":\"chat\"}",
            "message_sha256": "e63aef2f1a59bd478c3ec0456d9bc6d28e29f57d6a7d4f4d176b136d0dfb3d68",
            "namespace": "group:alpha/channel:general",
            "operation": "put",
            "retention_mode": "ttl"
          }
        }
      ]
    }
  ],
